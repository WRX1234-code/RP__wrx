            <mxPoint x="280" y="430" as="sourcePoint" />
            <mxPoint x="180" y="1290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
