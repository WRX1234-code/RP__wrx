syms phi2 phi3 xB yB l2 xD yD l3 phi1 phi4
%改文件用于计算phi2 phi3,11.22改了一下
xB = l1*cos(phi1);
yB = l1*sin(phi1);
xD = l4*cos(phi4);
yD = l4*sin(phi4);

% 方程组
eq1 = xB + l2 * cos(phi2) == xD + l3 * cos(phi3);
eq2 = yB + l2 * sin(phi2) == yD + l3 * sin(phi3);

% 求解 phi2 和 phi3
sol = solve([eq1, eq2], [phi2, phi3]);

% 显示 phi2 和 phi3 的解
phi2_explicit = simplify(sol.phi2);
phi3_explicit = simplify(sol.phi3);

% 只取第一个解
phi2_explicit = simplify(sol.phi2(1));
phi3_explicit = simplify(sol.phi3(1));

% 假设你已经通过某种方式得到一个复杂的 phi2 表达式
phi2_test = ... % 你的 phi2 表达式（非常长）

% 使用 simplify 函数进行简化
phi2_simplified = simplify(phi2);

% 显示简化后的结果
disp(phi2_simplified);
% 输出到屏幕
disp('Phi2 explicit equation:');
disp(phi2_explicit);
disp('Phi3 explicit equation:');
disp(phi3_explicit);



% 将结果转为 MATLAB 函数
matlabFunction(phi2_explicit, 'File', 'phi2_calculation');
matlabFunction(phi3_explicit, 'File', 'phi3_calculation');

phi2_calculation(0.15,0.27,0.27,0.15,3*pi/4,pi/4)
phi3_calculation(0.15,0.27,0.27,0.15,3*pi/4,pi/4)